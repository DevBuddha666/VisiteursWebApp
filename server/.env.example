# ─── Base de données (Supabase PostgreSQL) ───────────────────────
DATABASE_URL="postgresql://postgres:<VOTRE_MOT_DE_PASSE>@db.<VOTRE_PROJET>.supabase.co:5432/postgres"

# ─── JWT ─────────────────────────────────────────────────────────
JWT_SECRET="votre_secret_jwt_tres_long_et_aleatoire_min_64_caracteres"
JWT_REFRESH_SECRET="votre_refresh_secret_different_du_premier_min_64_caracteres"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Serveur ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:5173"

# ─── URL publique du frontend (pour générer les QR codes) ────────
PUBLIC_URL="http://localhost:5173"
